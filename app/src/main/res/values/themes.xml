<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Zette" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Main Color -->
        <item name="colorPrimary">@color/green_brand</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="colorPrimaryContainer">@color/green_mint</item>
        <item name="colorOnPrimaryContainer">@color/green_deep</item>
        <item name="colorSecondary">@color/green_accent</item>
        <item name="colorOnSecondary">@color/text_on_accent</item>
        <item name="colorSecondaryContainer">@color/green_mint</item>
        <item name="colorOnSecondaryContainer">@color/green_deep</item>

        <!-- Background / Surface -->
        <item name="android:colorBackground">@color/surface_canvas</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/surface_container</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_ceramic</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/surface_container</item>
        <item name="colorSurfaceContainerLow">@color/surface_cool</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_raised</item>
        <item name="colorSurfaceContainerHighest">@color/surface_ceramic</item>

        <!-- Line -->
        <item name="colorOutline">@color/border_input</item>
        <item name="colorOutlineVariant">@color/border_hairline</item>

        <!-- Error -->
        <item name="colorError">@color/semantic_error</item>
        <item name="colorOnError">@color/text_on_error</item>

        <!-- System Bar -->
        <item name="android:statusBarColor">@color/surface_canvas</item>
        <item name="android:navigationBarColor">@color/surface_canvas</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_system_bars</item>

        <item name="fontFamily">@font/pretendard</item>
        <item name="android:fontFamily">@font/pretendard</item>

        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Zette.Display</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Zette.H1</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Zette.H2</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Zette.Title</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Zette.Subtitle</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Zette.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Zette.Body</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Zette.Caption</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Zette.Button</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Zette.Label</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Zette.LabelSmall</item>

        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Zette.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Zette.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Zette.Large</item>
    </style>

    <style name="ShapeAppearance.Zette.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_sm</item>
    </style>
    <style name="ShapeAppearance.Zette.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_md</item>
    </style>
    <style name="ShapeAppearance.Zette.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_lg</item>
    </style>
</resources>
